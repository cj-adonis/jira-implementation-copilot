# Local API port (the Vite proxy defaults to 3001).
PORT=3001

# Optional overrides. Defaults discover managing-jira in ~/.agents or ~/.codex.
# Use an absolute skill directory and a Python executable, without command arguments.
# MANAGING_JIRA_SKILL_PATH=C:/Users/you/.agents/skills/managing-jira
# MANAGING_JIRA_PYTHON=C:/Path/To/python.exe

# Jira MX uses Samsung SSO through managing-jira; no API token is needed.
