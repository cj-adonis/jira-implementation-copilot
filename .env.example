# Required for Jira retrieval. Never prefix secrets with VITE_.
JIRA_BASE_URL=https://your-jira.example.com
JIRA_PAT=replace-with-your-bearer-token

# Select openai or gemini, then provide the matching key.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
